// Builds evals/results.md from the saved runs in evals/runs/.
import { readdirSync, readFileSync, writeFileSync } from "node:fs";

const dir = new URL("runs/", import.meta.url);
const runs = readdirSync(dir).filter((f) => f.endsWith(".json")).sort()
  .map((f) => JSON.parse(readFileSync(new URL(f, dir), "utf8")));

let md = "# Evaluation results\n\nGenerated by `npm run eval:report` from the raw runs in [`runs/`](runs/). Every number below comes from those files.\n\n" +
  "Metrics: **valid schema** (output parses with the Zod schema), **score in range** (match score inside the labelled range), " +
  "**missing-skill recall** (labelled must-detect gaps that were reported), **cases with false gaps** (a skill the CV has, or an alternative the CV already satisfies, reported as missing), " +
  "**split OR groups** (an \"A or B\" requirement reported as several separate gaps), **gap precision** / **match precision** (reported gaps / matches that appear in the job text).\n\n" +
  "Notes:\n\n- `0-baseline-metrics-v1` was the first run with only the first four metrics; it scored 100% on all of them, so the metrics and labels were extended (alternatives, grounding) before the real baseline `1-baseline`.\n" +
  "- The \"OR group\" failure was found by reading the raw dev outputs. The held-out cases `ho-11` and `ho-12` were written after that, but before any held-out run, to test whether the fix generalises.\n" +
  "- Each configuration was run once (single sample per case), so small score differences between runs are normal LLM variance.\n\n";
md += "| Run | Split | Model | Cases | Valid schema % | Score in range % | Missing-skill recall % | Cases with false gaps | Split OR groups | Gap precision % | Match precision % |\n|---|---|---|---|---|---|---|---|---|---|---|\n";
for (const r of runs) {
  const s = r.summary;
  md += `| ${r.label} | ${r.split} | ${r.model} | ${s.cases} | ${s.schemaValid} | ${s.scoreInRange} | ${s.missingRecall} | ${s.casesWithFalseGaps} | ${s.splitAlternatives === undefined ? "-" : `${s.splitAlternatives}/${s.alternativeGroups}`} | ${s.gapPrecision ?? "-"} | ${s.matchPrecision ?? "-"} |\n`;
}
for (const r of runs) {
  md += `\n## ${r.label} / ${r.split} (${r.date.slice(0, 10)})\n\n| Case | Score | In range | Missing found | Missed | False gaps | Split OR groups |\n|---|---|---|---|---|---|---|\n`;
  for (const c of r.results) {
    md += `| ${c.id} | ${c.score ?? "-"} | ${c.scoreInRange ? "yes" : "no"} | ${c.missingFound}/${c.missingTotal} | ${c.missedSkills.join(", ") || "-"} | ${c.falseGaps.join(", ") || "-"} | ${(c.splitAlternatives ?? []).join(", ") || "-"} |\n`;
  }
}
writeFileSync(new URL("../results.md", dir), md);
console.log(`wrote evals/results.md (${runs.length} runs)`);
